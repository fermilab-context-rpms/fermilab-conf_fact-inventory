[Unit]
Description=Fermilab system inventory

After=local-fs.target remote-fs.target network-online.target
Wants=local-fs.target network.target
Requires=local-fs.target network.target

StartLimitIntervalSec=3600
StartLimitBurst=4

[Service]
Type=oneshot

Environment=ANSIBLE_LOCAL_TEMP=/tmp/ansible-local
Environment=ANSIBLE_REMOTE_TEMP=/tmp/ansible-remote
ExecStart=/usr/bin/ansible-playbook -i hosts.yml gather.yml

Restart=on-failure
RestartSec=900
TimeoutStartSec=90

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadOnlyPaths=/
ReadWritePaths=/tmp

User=root
Group=root
UMask=0077

Nice=6
IOSchedulingClass=best-effort
IOSchedulingPriority=6

NoNewPrivileges=yes
AmbientCapabilities=
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
KeyringMode=private
LockPersonality=true
SystemCallArchitectures=native
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
