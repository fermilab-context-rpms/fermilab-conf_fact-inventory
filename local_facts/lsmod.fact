#!/bin/bash
# Must be executable (chmod +x) and end in .fact

if [[ -r /proc/modules ]]; then
    export LC_ALL=C.utf8

    names=()
    while read -r name _; do
        names+=("$name")
    done </proc/modules

    mapfile -t sorted_names < <(printf '%s\n' "${names[@]}" | sort)

    printf -v joined '"%s",' "${sorted_names[@]}"
    printf '{"lsmod": [%s]}\n' "${joined%,}"
fi
